{
  "info": {
    "_postman_id": "f53cdc7f-d9a9-53aa-8a7e-1b65112bc996",
    "name": "UberHub Auth — testes locais (perfil postman-mock)",
    "description": "Cenários fictícios das quatro APIs de autenticação. Requer o perfil postman-mock em 127.0.0.1:8081. Ver docs/POSTMAN-TESTES.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const documented = {\"/auth/register\": [201, 400, 401, 405, 409, 415, 500, 503], \"/auth/login\": [200, 400, 401, 403, 405, 409, 415, 500, 503], \"/auth/refresh\": [200, 400, 401, 403, 405, 415, 500, 503], \"/auth/recover-password\": [200, 400, 405, 415, 500, 503]};",
          "const problemCodes = [\"VALIDATION_ERROR\", \"MALFORMED_REQUEST\", \"INVALID_FIREBASE_TOKEN\", \"INVALID_REFRESH_TOKEN\", \"ACCOUNT_INACTIVE\", \"ACCOUNT_ALREADY_EXISTS\", \"REGISTRATION_REQUIRED\", \"DEPENDENCY_UNAVAILABLE\", \"INTERNAL_ERROR\"];",
          "const path = pm.request.url.getPath();",
          "const status = pm.response.code;",
          "pm.test(\"Status HTTP documentado em docs/auth-api.yaml para \" + path, function () {",
          "  pm.expect(documented[path] || [], \"rota fora do contrato\").to.include(status);",
          "});",
          "pm.test(\"Erros da API trazem code do contrato\", function () {",
          "  if ([400, 401, 403, 409, 500, 503].includes(status)) {",
          "    const b = pm.response.json();",
          "    pm.expect(problemCodes).to.include(b.code);",
          "  }",
          "});",
          "pm.test(\"Sem stack trace ou detalhe interno\", function () {",
          "  pm.expect(pm.response.text()).to.not.match(/Exception|at br\\.edu|stacktrace/i);",
          "});",
          "pm.test(\"Erros não ecoam credenciais enviadas\", function () {",
          "  if (status >= 400 && pm.request.body && pm.request.body.raw) {",
          "    const sent = JSON.parse(pm.request.body.raw);",
          "    Object.keys(sent).forEach(k => {",
          "      const v = String(sent[k]);",
          "      if (v.length > 3) pm.expect(pm.response.text()).to.not.include(v);",
          "    });",
          "  }",
          "});",
          "pm.test(\"Erros em JSON com Content-Type de problema\", function () {",
          "  if (status >= 400 && status !== 405 && pm.response.text().length > 0) {",
          "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
          "  }",
          "});",
          "pm.test(\"Respostas de token não são armazenadas em cache\", function () {",
          "  if (status === 200 && (path === \"/auth/login\" || path === \"/auth/refresh\")) {",
          "    pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\");",
          "  }",
          "});"
        ]
      }
    }
  ],
